# http://editorconfig.org
root = true

# All files
[*]
charset = utf-8
indent_style = space
indent_size = 2
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Markdown files
# (Trailing whitespace is significant in markdown for line breaks, so we don't trim it)
[*.md]
trim_trailing_whitespace = false

# Makefiles (Must use tabs)
[Makefile]
indent_style = tab